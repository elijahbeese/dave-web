# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Must match CAMERA_BRIDGE_TOKEN in daveweb's own .env -- that's how daveweb
# authenticates to this service.
CAMERA_BRIDGE_TOKEN=

# Door cam: Hikvision-compatible PoE IP camera. Full RTSP URL including
# credentials, e.g.:
#   rtsp://admin:yourpassword@10.0.0.31:554/Streaming/Channels/101
# Leave blank to fall back to a plain USB webcam at DOOR_CAM_DEVICE instead.
DOOR_CAM_RTSP_URL=

# Usually fine as-is -- override only if your setup differs from the
# defaults in config.py (second USB cam, non-standard resolution, etc).
# CAMERA_BRIDGE_PORT=8600
# DOOR_CAM_DEVICE=0
# WINDOW_CAM_CAMERA_NUM=0
