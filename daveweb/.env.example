# Generated by setup_mfa.py -- paste the three values it prints here.
DAVEWEB_SECRET_KEY=
DAVEWEB_PASSWORD_HASH=
DAVEWEB_TOTP_SECRET=

# Where api_server.py (D.A.V.E.'s own API) is already listening, and the
# SAME password you set for it (the one api_server.py checks on /login --
# whatever you exported as DAVE_GUI_PASSWORD when you started it, or set
# in its own systemd EnvironmentFile). daveweb logs into it on your behalf.
DAVE_API_BASE=http://127.0.0.1:8420
DAVE_GUI_PASSWORD=

# Local bind -- keep this on localhost. Tailscale Funnel is what makes it
# internet-reachable; this app itself should never listen on 0.0.0.0.
# 8421, not 8420 -- api_server.py already owns 8420 on this box.
DAVEWEB_HOST=127.0.0.1
DAVEWEB_PORT=8421

DAVEWEB_SESSION_HOURS=12
