# Copy to .env and fill in. All optional except nothing is strictly required —
# THREATWATCH runs with zero keys, just with OTX skipped and NVD rate-limited.

# Free, instant: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Free account required: https://otx.alienvault.com/settings
OTX_API_KEY=

# Point this at D.A.V.E.'s storage once deployed on yourhost, e.g.
# /mnt/dave-storage/threatwatch/threatwatch.db
THREATWATCH_DB_PATH=

# How many days back NVD pulls each run (default 7)
THREATWATCH_NVD_LOOKBACK_DAYS=7
